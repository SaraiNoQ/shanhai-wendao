{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shanhai-wendao",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wendao.sarainoq.cn",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
